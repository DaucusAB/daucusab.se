function renderSportsDays() {

    document
        .querySelectorAll(".day-button")
        .forEach(button => {

            const day =
                Number(
                    button.dataset.day
                );

            button.classList.toggle(
                "active",
                settings.sportsDays.includes(day)
            );

            button.onclick = () => {

                if (
                    settings.sportsDays.includes(day)
                ) {

                    settings.sportsDays =
                        settings.sportsDays.filter(
                            d => d !== day
                        );

                } else {

                    settings.sportsDays.push(day);

                }

                renderSportsDays();

            };

        });

}


