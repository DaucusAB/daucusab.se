        ).checked;

    document
        .querySelectorAll(
            "[data-timer-key]"
        )
        .forEach(input => {

            const key =
                input.dataset.timerKey;

            settings.timers[key] =
                Number(input.value);

        });

    saveSettingsToStorage();

    updateLeaveTime();

    const name =
        document.getElementById(
            "childName"
        );

    if (name) {
        name.textContent =
            settings.name || "";
    }

