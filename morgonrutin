========================================================= */

function updateProgress() {

    const total =
        steps.length;

    const done =
        completedSteps.size;

    const percentage =
        (done / total) * 100;

    document.getElementById(
        "overallProgressBar"
    ).style.width =
        percentage + "%";

    document.getElementById(
        "overallProgressText"
    ).textContent =
        `${done} av ${total} klara`;

    renderOverview();

}


function renderOverview() {

    const container =
        document.getElementById(
            "stepOverview"
        );

    if (!container) return;

    container.innerHTML = "";

    steps.forEach((step, index) => {

        const dot =
            document.createElement("div");

        dot.className = "step-dot";

        if (completedSteps.has(step.id)) {

            dot.classList.add("done");

            dot.textContent = "✓";

        } else if (
            index === currentStepIndex
        ) {

            dot.classList.add("current");

            dot.textContent =
                index + 1;

        } else {

            dot.textContent =
                index + 1;

        }

        container.appendChild(dot);

    });

}


