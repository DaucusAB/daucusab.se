    const button =
        document.getElementById(
            "spinButton"
        );

    button.disabled = true;

    wheel.classList.remove("spinning");

    void wheel.offsetWidth;

    wheel.classList.add("spinning");

    setTimeout(() => {

        const randomIndex =
            Math.floor(
                Math.random() *
                dressItems.length
            );

        const item =
            dressItems[randomIndex];

        dressItems.splice(
            randomIndex,
            1
        );

        dressCompleted.push(item);

        document.getElementById(
            "spinResult"
        ).innerHTML = `

            <div class="spin-result-icon">
                ${item.icon}
            </div>

            <div class="spin-result-text">
                ${item.name}!
            </div>

            <p>
                Ta på dig ${item.name.toLowerCase()}.
            </p>

        `;

        renderDressDone();

        button.disabled = false;

        if (dressItems.length === 0) {

            document.getElementById(
                "spinButton"
            ).textContent =
                "🎉 ALLA KLÄDER KLARA!";

        } else {

            button.textContent =
                "🎰 SNURRA IGEN!";

        }

        playSound("complete");

    }, 3000);

}


