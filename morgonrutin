/* =========================================================
   TIMER
========================================================= */

function startTimer(stepId, seconds) {

    clearInterval(activeTimer);

    const timer =
        document.getElementById("timer-" + stepId);

    if (!timer) return;

    let remaining = seconds;

    timer.dataset.remaining = remaining;

    updateTimerVisual(
        stepId,
        remaining,
        seconds
    );

    activeTimer = setInterval(() => {

        remaining--;

        timer.dataset.remaining = remaining;

        updateTimerVisual(
            stepId,
            remaining,
            seconds
        );

        if (remaining <= 0) {

            clearInterval(activeTimer);

            timer.classList.add("finished");

            playSound("finished");

        }

    }, 1000);
}


function updateTimerVisual(
    stepId,
    remaining,
    total
) {

    const number =
        document.getElementById(
            "timer-number-" + stepId
        );

    const bar =
        document.getElementById(
            "timer-bar-" + stepId
        );

    const timer =
        document.getElementById(
            "timer-" + stepId
        );

    if (!number || !bar) return;

    number.textContent =
        formatTime(Math.max(remaining, 0));

    const percent =
        Math.max(
            0,
            Math.min(
                100,
                (remaining / total) * 100
            )
        );

    bar.style.width = percent + "%";

    timer.classList.toggle(
        "warning",
        remaining <= 15 && remaining > 0
    );
}


function formatTime(seconds) {

    const min =
        Math.floor(seconds / 60);

    const sec =
        seconds % 60;

    return (
        String(min).padStart(2, "0") +
        ":" +
        String(sec).padStart(2, "0")
    );
}


/* =========================================================
   AKTIVERA STEG
========================================================= */

function activateStep(index) {

    if (index >= steps.length) {

        showCompletion();

        return;
    }

    currentStepIndex = index;

    document
        .querySelectorAll(".step-card")
        .forEach(card => {
            card.classList.remove("current");
        });

    const step =
        steps[index];

    const card =
        document.getElementById(
            "step-" + step.id
        );

    if (!card) return;

    card.classList.add("current");

    setTimeout(() => {

        card.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    }, 150);

    renderOverview();

    playSound("start");

    if (
        step.type !== "dressLottery" &&
        step.type !== "choice" &&
        step.type !== "sports"
    ) {

        startTimer(
            step.id,
            settings.timers[step.timerKey] || 60
        );
    }

}


/* =========================================================
   KLAR
========================================================= */

function completeStep(stepId) {

    const index =
        steps.findIndex(
            step => step.id === stepId
        );

    if (index === -1) return;

    if (completedSteps.has(stepId)) return;

    completedSteps.add(stepId);

    clearInterval(activeTimer);

    const card =
        document.getElementById(
            "step-" + stepId
        );

    if (card) {

        card.classList.remove("current");

        card.classList.add("done");

    }

    playSound("complete");

    updateProgress();

    setTimeout(() => {

        activateStep(index + 1);

    }, 400);

}


